# Backend runtime
NODE_ENV=production
PORT=8080

# Database
DATABASE_URL=postgres://user:password@host:5432/pricehub

# Sessions
SESSION_SECRET=replace-with-strong-random-secret
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=true

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://pricehub-group.vercel.app

# Optional
SEED_ON_START=false
