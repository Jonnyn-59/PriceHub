# Shared
NODE_ENV=production

# Frontend (artifacts/pricehub)
VITE_API_BASE_URL=https://api.your-domain.com
BASE_PATH=/
ENABLE_REPL_PLUGINS=false

# Backend (artifacts/api-server)
PORT=8080
DATABASE_URL=postgres://user:password@host:5432/pricehub
SESSION_SECRET=replace-with-strong-random-secret
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
SESSION_COOKIE_SAMESITE=none
SESSION_COOKIE_SECURE=true
SEED_ON_START=false

# Optional sandbox controls (artifacts/mockup-sandbox)
ENABLE_MOCKUP_SANDBOX=false
